/*
3796. Find Maximum Value in a constrained Sequence
Create an array a of size n and set:
 
a[0] = 0
 
all other values = very large (Infinity)
 
Apply all restrictions:
 
for each [idx, maxVal], set a[idx] = min(a[idx], maxVal)
 
Traverse left to right:
 
limit growth using diff
 
a[i+1] = min(a[i+1], a[i] + diff[i])
 
Traverse right to left:
 
limit decrease using diff
 
a[i] = min(a[i], a[i+1] + diff[i])
 
The array now satisfies all conditions.
 
Return the maximum value in a.
*/
 
/**
 * @param {number} n
 * @param {number[][]} restrictions
 * @param {number[]} diff
 * @return {number}
 */
var findMaxVal = function(n, restrictions, diff) {
    let a=new Array(n).fill(Infinity);
    a[0]=0;
    for(let [idx, maxVal] of restrictions){
        a[idx] = Math.min(a[idx], maxVal);
    }
    for(let i=0;i<n-1;i++){
        a[i+1]=Math.min(a[i+1],a[i]+diff[i]);
    }
    for(let i=n-2;i>=0;i--){
        a[i]=Math.min(a[i],a[i+1]+diff[i]);
    }
    let max=0;
    for(let val of a){
        max=Math.max(max,val);
    }
    return max;
};
