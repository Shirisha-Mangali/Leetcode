class Solution {
    public int minimumSumSubarray(List<Integer> nums, int l, int r) {
        int min=Integer.MAX_VALUE,f=0;
        int n=nums.size();
        for(int i=0;i<n;i++){
            int sum=0;
            for(int j=i;j<n;){
                sum+=nums.get(j);
            if(j<n && j-i+1<=r && j-i+1>=l&& sum>0){
                min= Math.min(sum, min);
                f=1;
                j++;
            }
                
            }
        }
        if(f==1)return min;
        return -1;
    }
}
