# 590. N-ary PostOrder Traversal
# Leetcode Link: https://leetcode.com/problems/n-ary-tree-postorder-traversal/
#Intuition:
1️ Postorder means children first, root last.
2️ Stack naturally gives root first.
3️ So we store values in root-first order.
4️ Then reverse the result at the end.
5️ Reversing converts root-first into children-first.

Reverse (Root → Children)
=
Children → Root

#Complexity
Time: O(n)
Space: O(n)



/*
// Definition for a Node.
class Node {
    public int val;
    public List<Node> children;

    public Node() {}

    public Node(int _val) {
        val = _val;
    }

    public Node(int _val, List<Node> _children) {
        val = _val;
        children = _children;
    }
}
*/

class Solution {
    public List<Integer> postorder(Node root) {
        List<Integer> post=new ArrayList<Integer>();
        if(root==null)return post;
        Stack<Node> st=new Stack<Node>();
        st.push(root);
        while(!st.isEmpty()){
            Node x=st.pop();
            post.add(x.val);
            for(Node c : x.children){
                st.push(c);
            }
        }
        Collections.reverse(post);
        return post;
    }
}
