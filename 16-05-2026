2784. Check if Array is Good

class Solution {
    public boolean isGood(int[] nums) {
        int n=nums.length-1;
        int c=0;
        Arrays.sort(nums);
       
        for(int i=0;i<n+1;i++){
            if(i<n)
                {if(nums[i]!=i+1){return false;}}
            else
                {if(nums[i]!=n){return false;}}
            
            
        }
        return true;
    }
}
