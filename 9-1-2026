150. Evaluate Reverse polish Notation
Lettcode link: https://leetcode.com/problems/evaluate-reverse-polish-notation/description/


/**
 * @param {string[]} tokens
 * @return {number}
 */
var evalRPN = function(tokens) {
    let stack=[];
    for(let c of tokens){
        if(c==="+"){
            stack.push(stack.pop()+stack.pop());
        }
        else if(c==="-"){
            let s=stack.pop();
            let f=stack.pop();
            stack.push(f-s);
        }
        else if(c==="*"){
            stack.push(stack.pop()*stack.pop());
        }
         else if(c==="/"){
            let s=stack.pop();
            let f=stack.pop();
            stack.push(parseInt(f/s));
        }else{
            stack.push(parseInt(c));
        }
    }
    return stack.pop();
};
