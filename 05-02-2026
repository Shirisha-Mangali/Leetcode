//349. Intersection of 2 Arrays
//Leetcode link: https://leetcode.com/problems/intersection-of-two-arrays/description/?envType=problem-list-v2&envId=sorting

/**
 * @param {number[]} nums1
 * @param {number[]} nums2
 * @return {number[]}
 */
var intersection = function(nums1, nums2) {
    let n1=nums1.length;
    let n2=nums2.length;
    let n=n1>n2?n1:n2;
    let res=[];
    let set=new Set();
    if(n==n1){
        for(let i=0;i<n;i++){
           if(nums2.includes(nums1[i]))set.add(nums1[i]); 
        }
    }else{
        for(let i=0;i<n;i++){
           if(nums1.includes(nums2[i]))set.add(nums2[i]); 
        }
    }
    for(let val of set)res.push(val);
    return res;
};
