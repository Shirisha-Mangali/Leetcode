3795. Minimum Subarray Lenth With Distinct Sum At Least K
 leetcode link: https://leetcode.com/problems/minimum-subarray-length-with-distinct-sum-at-least-k
 
/*Use two pointers (left and right) to represent a sliding window (subarray).
 
Use a frequency map to track how many times each number appears in the current window.
 
Maintain a variable distinctSum:
 
When a number enters the window for the first time, add it to distinctSum.
 
If the number is already present, do nothing.
 
Expand the window by moving right forward and updating the map and distinctSum.
 
When distinctSum ≥ k:
 
Update the minimum window length.
 
Shrink the window by moving left forward.
 
If a number’s frequency becomes 0, subtract it from distinctSum.
 
Repeat until the array ends.
 
If no valid subarray is found, return -1.
*/
 
 
 
/**
 * @param {number[]} nums
 * @param {number} k
 * @return {number}
 */
var minLength = function(nums, k) {
    let n=nums.length;
    let len=0;
    let minLen=Infinity;
    let sum=0;
    let l=0;
    let freq=new Map();
    for(let r=0;r<n;r++){
        let val=nums[r];
        freq.set(val,(freq.get(val)||0)+1);
        if(freq.get(val)==1)sum+=val;
 
        while(sum>=k){
            minLen=Math.min(minLen,r-l+1);
            freq.set(nums[l],freq.get(nums[l])-1);
            if(freq.get(nums[l])==0)sum-=nums[l];
            l++;
        }
    }
    return minLen==Infinity?-1:minLen;
};
